# Configure with Sites runtime secrets. Never commit real values.
STORE_ADMIN_EMAIL=
COMMERCE_ENABLED=false
# Canonical PUBLIC https origin. Private Sites cannot receive bKash callbacks.
SITE_PUBLIC_URL=
# sandbox or live. Sandbox orders cannot be fulfilled.
BKASH_ENV=sandbox
# Explicit merchant compatibility confirmation required. v2 is NOT implemented.
# bKash's official demo lists v2 as stable; this adapter supports the legacy API.
BKASH_API_VERSION=
# Set to v1.2.0-beta only if bKash confirms this merchant is enabled for it.
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
